<Window x:Class="VideoCutter.App.ExportResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VideoCutter.App.Converters"
        Title="VideoCutter — Export Results" Height="520" Width="640" MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel x:Name="FolderPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Output folder: " VerticalAlignment="Center"/>
            <TextBlock x:Name="FolderPathText" VerticalAlignment="Center" FontFamily="Consolas"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Button Content="Open Folder" Padding="8,2" Margin="12,0,0,0" Click="OpenFolder_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,1" Foreground="{Binding Passed, Converter={StaticResource BoolToBrush}}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}: {1} ({2:F1}s)">
                                        <Binding Path="FileName"/>
                                        <Binding Path="Message"/>
                                        <Binding Path="DurationSeconds"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save List..." Padding="10,4" Click="SaveList_Click"/>
            <Button Content="Close" Padding="16,4" Margin="8,0,0,0" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
