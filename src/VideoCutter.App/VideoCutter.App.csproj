<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VideoCutter</AssemblyName>
    <RootNamespace>VideoCutter.App</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Authors>James Collins</Authors>
    <Product>VideoCutter</Product>
    <Copyright>Copyright (c) 2026 James Collins</Copyright>
  </PropertyGroup>

  <!--
    Dynamic version: Major.Minor come from Directory.Build.props (manual, Major changes only on
    an explicit "major overhaul" instruction). The patch number is the live git commit count, so
    it advances automatically on every commit with zero upkeep. Falls back to 0/"nogit" if git
    or the repo isn't available (e.g. a zip-exported copy with no .git folder).
  -->
  <Target Name="ComputeGitVersion" BeforeTargets="BeforeBuild">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCountRaw" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShaRaw" />
    </Exec>
    <PropertyGroup>
      <GitCommitCount Condition="'$(GitCommitCountRaw)' != ''">$(GitCommitCountRaw)</GitCommitCount>
      <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
      <GitSha Condition="'$(GitShaRaw)' != ''">$(GitShaRaw)</GitSha>
      <GitSha Condition="'$(GitSha)' == ''">nogit</GitSha>
      <Version>$(VersionMajor).$(VersionMinor).$(GitCommitCount)</Version>
      <AssemblyVersion>$(VersionMajor).$(VersionMinor).$(GitCommitCount).0</AssemblyVersion>
      <FileVersion>$(VersionMajor).$(VersionMinor).$(GitCommitCount).0</FileVersion>
      <!-- Not setting InformationalVersion explicitly: the SDK auto-appends "+<full-git-sha>"
           to Version for it, which is more precise than our own short-sha suffix and avoids
           ending up with both appended at once. -->
    </PropertyGroup>
    <Message Importance="high" Text="VideoCutter version: $(Version) ($(GitSha))" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VideoCutter.Core\VideoCutter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.1" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\scissors.png" />
    <Resource Include="Resources\filmstrip.jpg" />
  </ItemGroup>

  <!--
    Ensures bundled ffmpeg/ffprobe exist before build. On a fresh clone the very first build
    will still skip the Content items below (MSBuild evaluates item Conditions before targets
    run), so after cloning run tools/Get-Ffmpeg.ps1 once, or just build twice.
  -->
  <Target Name="FetchFfmpeg" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Get-Ffmpeg.ps1&quot;" />
  </Target>

  <ItemGroup>
    <Content Include="..\..\tools\ffmpeg\ffmpeg.exe" Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')">
      <Link>ffmpeg\ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\tools\ffmpeg\ffprobe.exe" Condition="Exists('..\..\tools\ffmpeg\ffprobe.exe')">
      <Link>ffmpeg\ffprobe.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Licensing files always ship alongside the exe, even in a standalone zip/installer with no
      .git or repo structure around it. tools/ffmpeg/LICENSE.txt is GPLv3 (ffmpeg's own license,
      required because the binary above is GPL); the rest cover VideoCutter's own MIT license and
      the LGPL components (libvlc/LibVLCSharp). See THIRD-PARTY-NOTICES.md for the full breakdown.
    -->
    <Content Include="..\..\tools\ffmpeg\LICENSE.txt" Condition="Exists('..\..\tools\ffmpeg\LICENSE.txt')">
      <Link>ffmpeg\LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\licenses\**">
      <Link>licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
